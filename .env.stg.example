# Exclusivo de STG. Copiar a .env.stg y reemplazar todos los valores change_me.
POSTGRES_DB=guardian_stg
POSTGRES_USER=guardian_stg
POSTGRES_PASSWORD=change_me_stg_only
DATABASE_URL=postgresql+psycopg2://guardian_stg:change_me_stg_only@guardian-stg-db:5432/guardian_stg

GUARDIAN_ADMIN_USERNAME=admin
GUARDIAN_ADMIN_INITIAL_PASSWORD=change_me_stg_only
GUARDIAN_SESSION_SECRET=change_me_stg_only
DEVICE_BOOTSTRAP_TOKEN=change_me_stg_only
# Vacío en STG local: no hay hostname público separado de la API LAN.
GUARDIAN_ADMIN_HOST=
GUARDIAN_ADMIN_TIMEZONE=
GUARDIAN_ENVIRONMENT=STG
